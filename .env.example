# Google Gemini (free tier works) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# REQUIRED: services refuse to start / compose refuses to run without these
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=generate-with-python-c-import-secrets-print-secrets.token_urlsafe-48

# Optional
# CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY=false
# SQL_MAX_ROWS=100
# SQL_TIMEOUT_MS=5000
